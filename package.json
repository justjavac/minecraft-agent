{
  "name": "minecraft-cli",
  "version": "1.0.0",
  "description": "Agent-friendly Minecraft CLI powered by mineflayer.",
  "type": "module",
  "bin": {
    "mc-agent": "./dist/cli/index.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsup src/cli/index.ts --format esm --clean --out-dir dist/cli",
    "dev": "tsx src/cli/index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "mineflayer": "^4.37.1",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "tsup": "^8.5.0",
    "tsx": "^4.20.6",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
